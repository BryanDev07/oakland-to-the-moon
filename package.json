{
  "name": "oakland-to-the-moon",
  "version": "1.0.0",
  "private": true,
  "description": "OAKLAND TO THE MOON - a 16-bit single-player space mission engineering game (NASA Space Apps Challenge 2026 entry).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/generate-assets/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
